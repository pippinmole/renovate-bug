{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["^@pnpm/.*", "^pnpm$"],
      "groupName": "pnpm updates",
      "separateMajorMinor": true,
      "separateMinorPatch": true
    }
  ]
}
